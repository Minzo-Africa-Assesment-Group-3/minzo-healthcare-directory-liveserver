NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY_PRINT=false
MINZO_DB_NAME=minzo_interview
MINZO_DB_USER=minzo_app
MINZO_DB_PASSWORD=replace_with_a_strong_local_password
MINZO_DB_PORT=5434
# PostGIS Docker database (use the same password as MINZO_DB_PASSWORD):
DATABASE_URL=postgresql://minzo_app:replace_with_a_strong_local_password@localhost:5434/minzo_interview?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
SHUTDOWN_TIMEOUT_MS=10000
# Reserved for future authentication, email, and storage features.
# These values are not required or initialized by the health-only starter.
JWT_ACCESS_SECRET=replace_with_a_64_character_hex_secret
JWT_ISSUER=minzo-africa-api
JWT_AUDIENCE=minzo-africa-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_JWT_ACCESS_SECRET=replace_with_a_different_64_character_hex_secret
ADMIN_JWT_AUDIENCE=minzo-africa-admin
ADMIN_JWT_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_REFRESH_TOKEN_TTL_SECONDS=86400
ADMIN_LOGIN_OTP_TTL_SECONDS=300
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=5
ADMIN_LOGIN_OTP_HMAC_SECRET=replace_with_a_different_64_character_hex_secret
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_DISPLAY_NAME=Minzo Super Admin
SUPER_ADMIN_PASSWORD=replace_with_a_long_unique_password
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=Minzo Africa <no-reply@example.com>
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_HMAC_SECRET=replace_with_a_64_character_hex_secret
AI_MODERATION_SERVICE_KEY=replace_with_a_long_random_service_key
SERVICE_API_KEY=replace_with_the_ai_service_inbound_key
AI_SERVICE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=90000
AI_MODERATION_ACTOR_REFERENCE=langchain-review-moderator-v1
JOB_DASHBOARD_PORT=3010
PGBOSS_DASHBOARD_AUTH_USERNAME=replace_with_a_dashboard_username
PGBOSS_DASHBOARD_AUTH_PASSWORD=replace_with_a_dashboard_password
SUPABASE_URL=https://replace-with-your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_supabase_secret_key
SUPABASE_BUSINESS_CLAIMS_BUCKET=business-claim-documents
SUPABASE_BUSINESS_REGISTRATIONS_BUCKET=business-registration-documents
SUPABASE_BUSINESS_MEDIA_BUCKET=business-media
SUPABASE_USER_AVATARS_BUCKET=user-avatars
SUPABASE_DATA_IMPORTS_BUCKET=data-imports
