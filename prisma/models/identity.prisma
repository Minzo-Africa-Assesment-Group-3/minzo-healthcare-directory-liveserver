enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RefreshTokenRevocationReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN_REVOKED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  displayName     String     @map("display_name") @db.VarChar(100)
  phone           String?    @db.VarChar(30)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens                 RefreshToken[]
  emailVerificationTokens       EmailVerificationToken[]
  loginChallenges               LoginChallenge[]
  businessMemberships           BusinessMembership[]
  followedBusinesses            BusinessFollow[]
  businessStaffProfiles         BusinessStaffMember[]
  businessClaims                BusinessClaim[]
  businessClaimDocuments        BusinessClaimDocument[]
  businessRegistrationDocuments BusinessRegistrationDocument[]
  businessMediaBatches          BusinessMediaBatch[]
  reviews                       Review[]
  contactMessagesSent           BusinessContactMessage[]       @relation("BusinessContactMessageSender")
  contactMessagesRead           BusinessContactMessage[]       @relation("BusinessContactMessageReader")

  @@map("users")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuditActorType {
  ADMIN
  AUTOMATION
}

model AdminUser {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(320)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  displayName     String      @map("display_name") @db.VarChar(100)
  status          AdminStatus @default(ACTIVE)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt   DateTime?   @map("deactivated_at") @db.Timestamptz(6)

  loginChallenges         AdminLoginChallenge[]
  refreshTokens           AdminRefreshToken[]
  roles                   AdminUserRole[]
  businessClaimsReviewed  BusinessClaim[]          @relation("BusinessClaimReviewer")
  businessesVerified      Business[]               @relation("BusinessVerifier")
  businessesReviewed      Business[]               @relation("BusinessReviewer")
  businessMediaReviewed   BusinessMedia[]          @relation("BusinessMediaReviewer")
  reviewModerationActions ReviewModerationAction[] @relation("ReviewModerationAdmin")
  auditLogs               AuditLog[]               @relation("AuditLogAdminActor")

  @@map("admin_users")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorAdminId   String?        @map("actor_admin_id") @db.Uuid
  actorReference String?        @map("actor_reference") @db.VarChar(200)
  action         String         @db.VarChar(150)
  entityType     String         @map("entity_type") @db.VarChar(100)
  entityId       String         @map("entity_id") @db.Uuid
  metadata       Json?          @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  actorAdmin AdminUser? @relation("AuditLogAdminActor", fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AdminLoginChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  adminUserId    String    @map("admin_user_id") @db.Uuid
  otpDigest      String    @map("otp_digest") @db.VarChar(64)
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_login_challenges")
}

model AdminRefreshToken {
  id                String                        @id @default(uuid()) @db.Uuid
  adminUserId       String                        @map("admin_user_id") @db.Uuid
  familyId          String                        @map("family_id") @db.Uuid
  tokenHash         String                        @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime                      @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?                     @map("revoked_at") @db.Timestamptz(6)
  revocationReason  RefreshTokenRevocationReason? @map("revocation_reason")
  replacedByTokenId String?                       @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser  AdminUser          @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  replacedBy AdminRefreshToken? @relation("AdminRefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   AdminRefreshToken? @relation("AdminRefreshTokenRotation")

  @@index([adminUserId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUsers  AdminUserRole[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model AdminRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model LoginChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  otpDigest      String    @map("otp_digest") @db.VarChar(64)
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

model RefreshToken {
  id                String                        @id @default(uuid()) @db.Uuid
  userId            String                        @map("user_id") @db.Uuid
  familyId          String                        @map("family_id") @db.Uuid
  tokenHash         String                        @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime                      @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?                     @map("revoked_at") @db.Timestamptz(6)
  revocationReason  RefreshTokenRevocationReason? @map("revocation_reason")
  replacedByTokenId String?                       @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
