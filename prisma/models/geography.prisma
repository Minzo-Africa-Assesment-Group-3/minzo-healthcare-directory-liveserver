model County {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities City[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "counties_name_search_trgm_idx")
  @@map("counties")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  countyId  String   @map("county_id") @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  county County @relation(fields: [countyId], references: [id], onDelete: Restrict)

  @@unique([countyId, slug], map: "cities_county_id_slug_key")
  @@index([countyId, isActive, name, id], map: "cities_county_id_is_active_name_id_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "cities_name_search_trgm_idx")
  @@map("cities")
}
